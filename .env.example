# Copy to .env.local and fill in. Everything without NEXT_PUBLIC_ is server-only
# and must never be referenced from client code.

# ---------------------------------------------------------------------------
# LLM — the conversational agent. Required.
# ---------------------------------------------------------------------------
# "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional: any OpenAI-compatible endpoint (OpenRouter, a local model, a test double)
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Privy — login and the embedded, non-custodial Solana wallet. Required.
# dashboard.privy.io -> your app. Enable email OTP, passkey, and Solana
# embedded wallets with "create on login" set to users-without-wallets.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ---------------------------------------------------------------------------
# Solana. "devnet" (default) or "mainnet-beta".
# Use Helius or QuickNode: the public RPC will rate limit you mid-demo.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Onramper — card/Apple Pay/Google Pay -> SOL.
# Use a sandbox (pk_test_...) key so the demo skips live KYC.
# Enable Apple Pay and Google Pay in the dashboard's routing settings.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ONRAMPER_API_KEY=
NEXT_PUBLIC_ONRAMPER_WIDGET_BASE=https://buy.onramper.com
# Shared secret checked against the x-onramper-signature header on the webhook.
ONRAMPER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Jupiter — swap routing and USD prices. Works without a key on the lite tier.
# ---------------------------------------------------------------------------
JUPITER_API_KEY=
# JUPITER_API_BASE=https://lite-api.jup.ag

# ---------------------------------------------------------------------------
# Demo behaviour. Only has an effect on devnet.
# Set to "false" to disable simulated settlement.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=true
# Pre-funded devnet keypair used to deliver "purchased" SOL, as a JSON array of
# bytes (the contents of a solana-keygen id.json). Strongly recommended: the
# public devnet faucet is rate limited and will fail during a live demo.
DEMO_TREASURY_SECRET_KEY=
# Where the devnet stand-in for a stock purchase sends SOL.
DEMO_VAULT_ADDRESS=1nc1nerator11111111111111111111111111111111

# ---------------------------------------------------------------------------
# Landing page
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_VIDEO_ID=
